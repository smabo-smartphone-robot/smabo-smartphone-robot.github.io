---
// Starlight's header, plus the GitHub link and a language switch that stay
// visible on phones. Starlight hides its right-hand group below 50rem and
// moves it into the menu; here a compact copy shows in the header instead.
import config from 'virtual:starlight/user-config';
import { Icon } from '@astrojs/starlight/components';
import Default from '@astrojs/starlight/components/Header.astro';

const current = Astro.locals.starlightRoute.locale; // undefined for the root locale
const codes = Object.keys(config.locales ?? {}).filter((code) => code !== 'root');
// This page's path without its locale prefix ("/en/guides/x/" -> "/guides/x/").
const first = Astro.url.pathname.split('/')[1];
const bare = codes.includes(first) ? Astro.url.pathname.slice(first.length + 1) || '/' : Astro.url.pathname;
// The other languages, each linking to this same page in that language.
const others = Object.entries(config.locales ?? {})
	.filter(([code]) => (code === 'root' ? undefined : code) !== current)
	.map(([code, locale]) => ({
		href: code === 'root' ? bare : `/${code}${bare}`,
		lang: locale!.lang,
		short: (locale!.lang ?? code).slice(0, 2).toUpperCase(),
		label: locale!.label,
	}));
const social = config.social ?? [];
---

<div class="smabo-header">
	<Default />
	<div class="mobile-quick print:hidden">
		{others.map(({ href, lang, short, label }) => (
			<a class="quick-lang" href={href} hreflang={lang} lang={lang} title={label} aria-label={label}>
				<Icon name="translate" size="1rem" />
				<span>{short}</span>
			</a>
		))}
		{social.map(({ href, label, icon }) => (
			<a class="quick-icon" href={href} rel="me" title={label} aria-label={label}>
				<Icon name={icon} size="1.25rem" />
			</a>
		))}
	</div>
</div>

<style>
	.smabo-header {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		height: 100%;
	}
	.smabo-header > :global(.header) {
		flex: 1;
		min-width: 0;
	}
	.mobile-quick {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		/* No end margin: Starlight's header already pads its end for the fixed menu button,
		   and every pixel here is one the site title can use. */
	}
	.mobile-quick a {
		display: inline-flex;
		align-items: center;
		gap: 0.2rem;
		color: var(--sl-color-text-accent);
		text-decoration: none;
		font-size: var(--sl-text-xs);
		font-weight: 600;
		/* A comfortable tap target without growing the header. */
		padding: 0.4rem;
		margin: -0.4rem;
	}
	.mobile-quick a:hover {
		color: var(--sl-color-white);
	}
	@media (max-width: 49.99rem) {
		/* Pages without a sidebar (the top page) keep Starlight's language dropdown on
		   phones too; the compact switch above replaces it, leaving room for the title. */
		.smabo-header :global(starlight-lang-select) {
			display: none;
		}
	}
	@media (min-width: 50rem) {
		/* Wide screens already show these in Starlight's own right-hand group. */
		.mobile-quick {
			display: none;
		}
	}
</style>
